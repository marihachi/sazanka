{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!package-lock.json"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "cssModules": true
    }
  },
  "linter": {
    "includes": ["**", "!**/*.svg"],
    "rules": {
      "preset": "recommended",
      "style": {
        "useBlockStatements": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**/*.ts", "!src/**/use*.ts", "!src/ui/theme.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "React を使うのは .tsx と use*.ts だけ。計算処理とデータは画面に依存させない (agent/docs/structure.md)",
                  "react-dom": "React を使うのは .tsx と use*.ts だけ。計算処理とデータは画面に依存させない (agent/docs/structure.md)",
                  "@chakra-ui/react": "React を使うのは .tsx と use*.ts だけ。計算処理とデータは画面に依存させない (agent/docs/structure.md)"
                },
                "patterns": [
                  {
                    "group": ["@emotion/*"],
                    "message": "React を使うのは .tsx と use*.ts だけ。計算処理とデータは画面に依存させない (agent/docs/structure.md)"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
